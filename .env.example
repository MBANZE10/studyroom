PORT=3000
JWT_SECRET=change_this_super_secret_key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://localhost:5501,https://mbanze10.github.io
FRONTEND_URL=http://localhost:3000

# Configure Gmail SMTP for password-reset delivery.
# Create a Google App Password (requires 2-Step Verification); never use your
# regular Gmail password. When SMTP_HOST is omitted with credentials set,
# StudyRoom defaults to smtp.gmail.com:465 with TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=StudyRoom <your-account@gmail.com>

# Optional: use a persistent mounted directory if deploying the JSON store.
# This must be backed by a Render persistent disk; the default filesystem is ephemeral.
# STUDYROOM_DATA_DIR=/var/data/studyroom
